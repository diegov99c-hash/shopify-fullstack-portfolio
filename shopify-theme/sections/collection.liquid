{% comment %}
  This section is used in the collection template to render collection page
  listing all products within a collection.

  https://shopify.dev/docs/storefronts/themes/architecture/templates/collection
{% endcomment %}

<section class="collection-page">
  <header class="collection-page__header">
    <h1>{{ collection.title }}</h1>
  </header>

  {% paginate collection.products by 20 %}
    <div class="collection-products">
      {% for product in collection.products %}
        <article class="collection-product">
          {% if product.featured_image %}
            {% render 'image',
              class: 'collection-product__image',
              image: product.featured_image,
              url: product.url,
              width: 600,
              height: 600,
              crop: 'center'
            %}
          {% endif %}
          <div class="collection-product__content">
            <h2>
              <a href="{{ product.url }}">{{ product.title | escape }}</a>
            </h2>
            <p>{{ product.price | money }}</p>
          </div>
        </article>
      {% endfor %}
    </div>

    {{ paginate | default_pagination }}
  {% endpaginate %}
</section>

{% stylesheet %}
  .collection-page {
    display: grid;
    gap: 28px;
    padding-block: 48px;
    overflow-x: clip;
  }

  .collection-page__header h1 {
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
  }

  .collection-products {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    min-width: 0;
  }

  .collection-product {
    display: grid;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: 8px;
    background: #fff;
  }

  .collection-product__image,
  .collection-product__image img {
    width: 100%;
  }

  .collection-product__image img {
    aspect-ratio: 1;
    object-fit: cover;
  }

  .collection-product__content {
    display: grid;
    gap: 8px;
    min-width: 0;
    padding: 14px;
  }

  .collection-product__content h2 {
    font-size: 1rem;
    line-height: 1.25;
  }

  .collection-product__content a {
    color: inherit;
    text-decoration: none;
  }

  .collection-product__content a:hover {
    text-decoration: underline;
  }

  .collection-product__content p {
    font-weight: 700;
  }

  .collection-page .pagination {
    margin-top: 8px;
  }

  @media screen and (max-width: 1199px) {
    .collection-products {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 989px) {
    .collection-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }
  }

  @media screen and (max-width: 749px) {
    .collection-page {
      gap: 22px;
      padding-block: 32px;
    }

    .collection-products {
      gap: 12px;
    }

    .collection-product__content {
      padding: 12px;
    }

    .collection-product__content h2 {
      font-size: 0.95rem;
    }
  }

  @media screen and (max-width: 359px) {
    .collection-products {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.collection",
  "settings": []
}
{% endschema %}
