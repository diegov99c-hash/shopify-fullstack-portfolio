<section class="portfolio-hero">
  <div class="portfolio-hero__content">

    {% if section.settings.heading != blank %}
      <h1 class="portfolio-hero__heading">
        {{ section.settings.heading }}
      </h1>
    {% endif %}

    {% if section.settings.description != blank %}
      <p class="portfolio-hero__description">
        {{ section.settings.description }}
      </p>
    {% endif %}

    {% if section.settings.button_text != blank %}
      <a
        href="{{ section.settings.button_link }}"
        class="portfolio-hero__button"
      >
        {{ section.settings.button_text }}
      </a>
    {% endif %}

  </div>

  {% if section.settings.hero_image != blank %}
    <div class="portfolio-hero__image">
      {{
        section.settings.hero_image
        | image_url: width: 1200
        | image_tag:
          loading: 'lazy',
          widths: '400, 600, 800, 1200'
      }}
    </div>
  {% endif %}
</section>

<style>
  .portfolio-hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
    padding: 64px 32px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .portfolio-hero__heading {
    font-size: clamp(2rem, 5vw, 4rem);
    margin-bottom: 20px;
  }

  .portfolio-hero__description {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 28px;
  }

  .portfolio-hero__button {
    display: inline-block;
    padding: 12px 24px;
    text-decoration: none;
    border: 1px solid currentColor;
  }

  .portfolio-hero__image img {
    width: 100%;
    height: auto;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .portfolio-hero {
      grid-template-columns: 1fr;
      padding: 40px 20px;
    }
  }
</style>

{% schema %}
{
  "name": "Portfolio hero",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build something worth discovering"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "A custom Shopify experience built with Liquid, JavaScript and modern web development practices."
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Portfolio hero"
    }
  ]
}
{% endschema %}