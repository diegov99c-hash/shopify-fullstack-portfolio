# Shopify CLI supplies Shopify app variables during `shopify app dev`.
# Keep real secrets in `.env`; `.env` is ignored by Git.

# Local development example:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/integration_service_dev?schema=public"

# Production PostgreSQL should require TLS/SSL. Provider formats vary, but many
# accept sslmode=require:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?schema=public&sslmode=require"
